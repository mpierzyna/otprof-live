# Settings of the pipelines (copy to .env). Paths are relative to pipeline/; all optional, defaults below data/.
# OTPROF_DATA=data                      # data root of both pipelines
# OTPROF_FORECAST_DATA=data/live        # run directories of the live pipeline
# OTPROF_WEBUI_DATA=data/webui          # the web app's data root (uploaded by live/step_4_upload.sh)
# OTPROF_CLIM_DATA=data/climatology     # ERA5, predictions and statistics of the climatology pipeline
